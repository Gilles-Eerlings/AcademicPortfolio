---
interface Author {
  name: string;
  self?: boolean;
  url?: string;
}

interface Link {
  label: string;
  url: string;
  external?: boolean;
}

interface Props {
  title: string;
  authors: Author[];
  venue: string;
  description?: string;
  links?: Link[];
}

const {
  title,
  authors,
  venue,
  description,
  links = [],
} = Astro.props;
const projectLink = links.find((link) => link.label === "Project");
---

<article class="border-b border-neutral-200 py-8 first:pt-0">
<h3
  class="text-xl font-medium leading-snug tracking-[-0.015em]
         text-neutral-900"
>
  {
    projectLink ? (
      <a
        href={projectLink.url}
        class="transition-colors hover:text-accent"
      >
        {title}
      </a>
    ) : (
      title
    )
  }
</h3>

  <p class="mt-2 text-sm leading-6 text-neutral-600">
    {
      authors.map((author, index) => (
        <>
          {index > 0 && <span>{", "}</span>}

          {author.url ? (
            <a
              href={author.url}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                "transition-colors hover:text-accent",
                author.self
                  ? "font-semibold text-accent"
                  : "text-neutral-600",
              ]}
            >
              {author.name}
            </a>
          ) : (
            <span
              class:list={[
                author.self
                  ? "font-semibold text-accent"
                  : "text-neutral-600",
              ]}
            >
              {author.name}
            </span>
          )}
        </>
      ))
    }
  </p>

  <p class="mt-1 text-sm text-neutral-500">
    {venue}
  </p>

  {
    description && (
      <p class="mt-3 text-base leading-7 text-neutral-600">
        {description}
      </p>
    )
  }

  {
    links.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
        {links.map((link) => (
          <a
            href={link.url}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class="font-mono text-xs uppercase tracking-[0.08em]
                   text-neutral-600 transition-colors
                   hover:text-accent"
          >
            {link.label}
            {link.external ? " ↗" : " →"}
          </a>
        ))}
      </div>
    )
  }
</article>